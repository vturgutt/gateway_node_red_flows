        "id": "ea5cc1c030bda7a8",
        "type": "function",
        "z": "10042627cf830640",
        "name": "RPC Confirmation",
        "func": "var confirm_id_array = msg.topic.split(\"/\")\nvar confirm_id = confirm_id_array[confirm_id_array.length - 1 ];\n\n\nvar new_message = {};\nnew_message.payload = {\n    \"status\": \"Recieved the RPC\"\n}\nnew_message.topic = \"v1/devices/me/rpc/response/\" + confirm_id;\nreturn new_message;",

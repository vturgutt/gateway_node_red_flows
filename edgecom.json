    {
        "id": "7d16f3a00e34bc8f",
        "type": "function",
        "z": "10042627cf830640",
        "name": "Send downlink",
        "func": "var new_message= {};\nvar deveui = msg.payload.params.devEUI;\nvar data = msg.payload.params.data;\nvar port = msg.payload.params.port;\n// Convert the hex string data into a byte buffer\nvar rawBytes = Buffer.from(data, 'hex');\n\n// Convert the raw bytes to Base64\nvar base64data = rawBytes.toString('base64');\n\n\nvar payload = {\n    \"data\": base64data,\n    \"fPort\": port,\n    \"devEUI\": deveui,\n    \"confirmed\": true\n};\n\nnew_message.topic = \"application/1/device/\" + deveui + \"/tx\"\nnew_message.payload = payload;\nreturn new_message;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 620,
        "y": 320,
        "wires": [

    {
        "id": "5861e1bd3122bb50",
        "type": "function",
        "z": "10042627cf830640",
        "name": "Log In to API",
        "func": "// Extract device info from original payload (before it's overwritten)\nvar deviceInfo = {};\nif (msg.payload && msg.payload.params) {\n    deviceInfo = msg.payload.params;\n}\n\n// Save device info to msg for later use\nmsg.deviceInfo = deviceInfo;\n\n// Prepare login POST\nmsg.method = \"POST\";\nmsg.url = \"https://127.0.0.1:8080/api/internal/login\";\n\n// Set login credentials\nmsg.payload = {\n    username: \"admin\",\n    password: \"98JF+lUu6bORfE2cAhCnUw==\"  // Use encrypted password if UG65 encryption is enabled\n};\n\n// Allow HTTPS with self-signed cert\nmsg.rejectUnauthorized = false;\n\n// Required headers\nmsg.headers = {\n    \"Content-Type\": \"application/json\"\n};\n\nreturn msg;\n",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",

    {
        "id": "d79898863eb16251",
        "type": "function",
        "z": "10042627cf830640",
        "name": "Send Cell status",
        "func": "console.log(msg);\nvar new_message = {};\nnew_message.time = Date.now();\n\nvar new_payload = {};\nvar infos = {};\ninfos.values = {};\ninfos.ts = Date.now();\n\nvar payload = msg.payload;\n//node.warn(payload);\n// Extract RSSI (-53dBm)\nvar match = payload.match(/Signal\\s*:\\s*(-?\\d+)dBm/);\nvar value;\nif (match && match[1]) {\n    value = match[1]; // Extracted RSSI value\n} else {\n    value = null; // No match found\n}\ninfos.values.rssi = value;\n\n// Extract Serial Number (sn)\nvar sn_match = payload.match(/sn:([\\w\\d]+)/);\nvar sn;\nif (sn_match && sn_match[1]) {\n    sn = sn_match[1]; // Extracted serial number\n} else {\n    sn = null;\n}\n//infos.values.sn = sn;\n\n// Extract Network Provider\nvar operator_match = payload.match(/Network Provider:\\s*(.+)/);\nvar operator;\nif (operator_match && operator_match[1]) {\n    operator = operator_match[1].trim(); // Extracted network provider\n} else {\n    operator = null;\n}\ninfos.values.operator = operator;\n\n// Extract ICCID\nvar iccid_match = payload.match(/ICCID\\s*:\\s*(\\d+)/);\nvar iccid;\nif (iccid_match && iccid_match[1]) {\n    iccid = iccid_match[1].trim(); // Extracted ICCID\n} else {\n    iccid = null;\n}\n//infos.values.iccid = iccid;\n\n// Extract Network Type\nvar network_match = payload.match(/Network Type\\s*:\\s*(.+)/);\nvar network;\nif (network_match && network_match[1]) {\n    network = network_match[1].trim(); // Extracted Network type\n} else {\n    network = null;\n}\ninfos.values.network = network;\n\nvar gwName =  \"Gateway: \" + sn ;\n\ninfos.values.familyType = \"Milesight\";\ninfos.values.devicetype = \"Gateway\";\n\nnew_message.topic = \"v1/gateway/telemetry\";\nnew_payload[gwName] = [infos];\nnew_message.payload = new_payload;\nreturn new_message;\n",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],

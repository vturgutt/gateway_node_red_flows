    {
        "id": "79afac59414e79e8",
        "type": "function",
        "z": "10042627cf830640",
        "name": "Add Device",
        "func": "// Parse payload (it's a string)\nconst response = JSON.parse(msg.payload);\n\n// Construct payload exactly as required\nmsg.payload = {\n    devEUI: msg.deviceInfo.devEUI,\n    name: msg.deviceInfo.devEUI,\n    appKey: msg.deviceInfo.appkey,\n    applicationID: \"1\",\n    skipFCntCheck: true\n};\n\n// Set HTTP method and endpoint\nmsg.method = \"POST\";\nmsg.url = \"https://127.0.0.1:8080/api/urdevices\";\n\n// Include Bearer token from login step\nmsg.headers = {\n    \"Authorization\": \"Bearer \" + response.jwt,\n    \"Content-Type\": \"application/json\"\n};\n\n// Accept self-signed certs\nmsg.rejectUnauthorized = false;\n\nreturn msg;\n",

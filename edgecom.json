    {
        "id": "525235fe5c524860",
        "type": "function",
        "z": "10042627cf830640",
        "name": "Extract Data",
        "func": "// Extract the important info\nvar new_msg = {};\n\n// Convert Base64 to Hex\nvar decodedDataHex = Buffer.from(msg.payload.data, 'base64').toString('hex');\nvar upperdeveui = msg.payload.devEUI.toUpperCase();\nnew_msg.payload = {\n    [upperdeveui]: [\n        {\n            \"ts\": (new Date().getTime())/1000, // Convert time to timestamp (ms)\n            \"values\": {\n                \"data\": decodedDataHex,  // Store as hex string\n                \"rssi\": msg.payload.rxInfo[0].rssi,\n                \"snr\": msg.payload.rxInfo[0].loRaSNR,\n                \"port\": msg.payload.fPort,\n                \"deveui\": upperdeveui,\n            }\n        }\n    ]\n};\nnew_msg.topic =\"v1/gateway/telemetry\";\nreturn new_msg;\n",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
